{
  "page": {
    "size": "A4",
    "margins_cm": {
      "left": 4,
      "top": 4,
      "right": 3,
      "bottom": 3
    },
    "margin_tolerance_cm": 0.2
  },
  "body": {
    "font_family": "Times New Roman",
    "font_size_pt": 12,
    "line_spacing": [1.5, 2.0],
    "first_line_indent_cm": 1.25,
    "alignment": "justify"
  },
  "chapter_heading": {
    "pattern": "^BAB [IVX]+$",
    "uppercase": true,
    "alignment": "center",
    "bold": true
  },
  "page_numbering": {
    "front_matter": "lower_roman",
    "body": "arabic",
    "body_starts_at": "BAB I"
  },
  "captions": {
    "table_position": "above",
    "figure_position": "below",
    "numbering": "chapter.sequence"
  },
  "required_sections": [
    "HALAMAN JUDUL",
    "LEMBAR PENGESAHAN",
    "ABSTRAK",
    "KATA PENGANTAR",
    "DAFTAR ISI",
    "BAB I",
    "BAB II",
    "BAB III",
    "BAB IV",
    "BAB V",
    "DAFTAR PUSTAKA"
  ],
  "abstract_words": {
    "min": 150,
    "max": 300
  },
  "min_chapter_words": 100,
  "citation": {
    "style": "apa",
    "max_source_age_years": 10,
    "max_old_source_ratio": 0.3
  },
  "severity_weights": {
    "critical": 10,
    "major": 3,
    "minor": 1
  },
  "disabled_rules": [],
  "subheading": {
    "bold": true,
    "capitalization": "any"
  },
  "reference_line_spacing": 1,
  "required_subsections": {},
  "max_sentence_words": 40,
  "methodology_keywords": [
    {
      "label": "Populasi atau sampel",
      "any": ["populasi", "sampel", "subjek", "partisipan", "informan", "responden"]
    },
    {
      "label": "Instrumen atau teknik pengumpulan data",
      "any": [
        "instrumen",
        "kuesioner",
        "angket",
        "wawancara",
        "observasi",
        "dokumentasi",
        "studi pustaka"
      ]
    },
    {
      "label": "Teknik analisis data",
      "any": ["analisis", "regresi", "deskriptif", "statistik", "reduksi", "uji "]
    }
  ]
}
