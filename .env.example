# Server saja (jangan pernah berawalan NEXT_PUBLIC_)
DATABASE_URL=                  # connection string pooler Supabase (mode transaction)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # untuk Storage dan Admin API
SUPABASE_STORAGE_BUCKET=manuscripts
# Storage naskah: "supabase" (bawaan) atau "r2" (Cloudflare R2). Auth dan database tetap Supabase.
STORAGE_PROVIDER=supabase
R2_ACCOUNT_ID=                 # hanya bila STORAGE_PROVIDER=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
ACCESS_CODE_HMAC_SECRET=       # acak, minimal 32 byte. Jangan diganti setelah ada kode dibagikan
CRON_SECRET=                   # untuk /api/internal/maintenance, sama dengan secret di GitHub Actions
SUPERADMIN_EMAIL=              # akun ini otomatis menjadi superadmin saat pertama masuk
APP_BASE_URL=http://localhost:3000
FILE_RETENTION_DAYS=30
MAX_UPLOAD_MB=25

# Opsional: pantau deploy Vercel di Admin > Sistem (token: Vercel > Account Settings > Tokens)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=                # kosongkan bila proyek di akun pribadi

# Opsional: pengingat email akses hampir habis. Kosongkan bila belum dipakai; pengingat dilewati.
RESEND_API_KEY=
EMAIL_FROM=                    # contoh: Skrippy <halo@skrippy.id>

# Boleh dibaca browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
